# Telegram
TELEGRAM_BOT_TOKEN=123456:replace_me
# Comma-separated Telegram numeric user IDs allowed to control the server.
ADMIN_USER_IDS=123456789

# Where commands execute: local (bot runs on the inference server) or ssh (bot runs elsewhere).
CONTROL_MODE=ssh
# SSH connection. Any clone can be pointed at another server by changing these values.
SERVER_HOST=192.168.8.248
SERVER_PORT=22
SERVER_USER=love
SSH_KEY_PATH=~/.ssh/id_ed25519
SSH_STRICT_HOST_KEY_CHECKING=yes
# Legacy alternative: set SSH_TARGET to an existing ~/.ssh/config alias and leave SERVER_* unused.
SSH_TARGET=

# systemd service names. Set the names used by your server.
COMFYUI_SERVICE=comfyui.service
VLLM_SERVICE=vllm.service

# Prefix used for systemctl. Keep sudo -n when the bot user has passwordless sudo for these services.
SYSTEMCTL_CMD=sudo -n /usr/bin/systemctl
JOURNALCTL_CMD=/usr/bin/journalctl

# Optional URLs shown in the dashboard.
COMFYUI_URL=http://127.0.0.1:8188
VLLM_URL=http://127.0.0.1:8000

# How many journal lines the Logs button returns.
LOG_LINES=30

# Network exposure toggle. The bot calls one of these fixed commands; keep them server-side and audited.
# They should switch bind/firewall rules for both inference services and may restart them.
EXPOSURE_MODE=local
LOCAL_BIND_HOST=192.168.1.100
PUBLIC_BIND_HOST=0.0.0.0
EXPOSURE_LOCAL_CMD=sudo -n env AI_LOCAL_BIND={local_bind} AI_PUBLIC_BIND={public_bind} /usr/local/sbin/ai-inference-exposure local
EXPOSURE_PUBLIC_CMD=sudo -n env AI_LOCAL_BIND={local_bind} AI_PUBLIC_BIND={public_bind} /usr/local/sbin/ai-inference-exposure public
EXPOSURE_STATUS_CMD=sudo -n /usr/local/sbin/ai-inference-exposure status
